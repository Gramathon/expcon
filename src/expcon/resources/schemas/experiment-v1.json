{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Expcon Experiment Contract v1",
  "type": "object",
  "required": ["schema_version", "experiment", "hypothesis", "execution", "evaluation", "outputs", "reproducibility"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "identity_algorithm": {"type": "string", "enum": ["expcon-canonical-v1"]},
    "hash_algorithm": {"type": "string", "enum": ["sha256"]},
    "experiment": {"type": "object", "required": ["id", "version", "title"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^v[0-9]+$"}, "title": {"type": "string"}, "description": {"type": "string"}}, "additionalProperties": true},
    "hypothesis": {"type": "object", "required": ["statement"], "properties": {"statement": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "source": {"type": "object", "additionalProperties": true},
    "data": {"type": "object", "additionalProperties": true},
    "execution": {"type": "object", "required": ["allowed_backends"], "properties": {"allowed_backends": {"type": "array", "minItems": 1, "items": {"enum": ["local", "kaggle", "colab"]}}, "accelerator": {"type": "object"}, "requirements": {"type": "object", "additionalProperties": true}, "stages": {"type": "array", "items": {"type": "object", "required": ["id", "entrypoint"], "properties": {"id": {"type": "string", "minLength": 1}, "entrypoint": {"type": "string", "minLength": 1}, "requires": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}}}, "additionalProperties": true},
    "environment": {"type": "object", "additionalProperties": true},
    "evaluation": {"type": "object", "required": ["primary_metric"], "properties": {"primary_metric": {"type": "string", "minLength": 1}, "acceptance": {"type": "object"}}, "additionalProperties": true},
    "outputs": {"type": "object", "required": ["required"], "properties": {"required": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": true},
    "reproducibility": {"type": "object", "required": ["level"], "properties": {"level": {"enum": ["functional", "seeded", "framework_deterministic", "hardware_constrained", "bitwise"]}}, "additionalProperties": true},
    "scientific_parameters": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": true
}
